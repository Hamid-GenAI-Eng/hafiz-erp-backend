{
    "name": "hafiz-building-material-backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "bin": "dist/index.js",
    "pkg": {
        "scripts": "dist/**/*.js",
        "assets": [
            "node_modules/drizzle-orm/**/*",
            "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
            "drizzle/**/*"
        ],
        "targets": [
            "node18-win-x64"
        ]
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "package-sidecar": "npm rebuild better-sqlite3 --target=18.0.0 --libc=glibc && tsc && npx pkg . && copy hafiz-building-material-backend.exe \"../Hafiz building material frontend/src-tauri/bin/backend-x86_64-pc-windows-msvc.exe\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "postgres": "^3.4.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.2.0",
        "drizzle-kit": "^0.31.10",
        "pkg": "^5.8.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}
